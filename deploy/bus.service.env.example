# Bus service environment (EXAMPLE ONLY — placeholders, never real values).
# Copy outside the repo, fill in, and reference as an EnvironmentFile= with
# mode 0600 in the graeae-hive.service unit. No address-derived value lives
# here: the bus SERVES HIVE_URL, it does not consume it.

# Admin tier for agent deregistration and /v1/admin/* (see docs/ENVIRONMENT.md
# "Agent deregistration"). With this unset, only an agent itself can
# deregister; the doctor cannot act as admin.
HIVE_BUS_ADMIN_TOKEN=<from key store>
