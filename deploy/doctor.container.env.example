# Doctor container environment (EXAMPLE ONLY — placeholders, never real values).
# Copy outside the repo, fill in, and reference as a quadlet EnvironmentFile=
# with mode 0600. Non-secret values may alternatively go in quadlet
# Environment= lines; tokens MUST stay in this file (0600) and never in
# Environment= lines, unit files, or the repo.
#
# Required set mirrors docs/environment-requirements.json (profile: doctor).
# Placeholders use <...> and never a real hostname, address, or token.

# Bus (required).
HIVE_URL=http://<bus-host>:5005
# Fleet inventory path on the control host (required; read-only bind mount
# the real JSON there — see docs/CONTROL_HOST_DEPLOY.md).
HIVE_FLEET_INVENTORY=/etc/graeae/fleet-inventory.json

# MNEMOS (both required).
MNEMOS_URL=http://<mnemos-host>:5002
MNEMOS_TOKEN=<from key store>

# Doctor admin token (required to register as orchestrator and call /v1/admin/*).
HIVE_BUS_ADMIN_TOKEN=<from key store>

# Model endpoints (openweight + fix required; the rest optional).
# See docs/ENVIRONMENT.md for the full table.
DOCTOR_OPENWEIGHT_BASE_URL=http://<cerberus-host>:8080/v1
DOCTOR_FIX_BASE_URL=http://<tydeus-host>:8006/v1
DOCTOR_TRIAGE_BASE_URL=
DOCTOR_REVIEW_BASE_URL=
DOCTOR_FALLBACK_BASE_URLS=
DOCTOR_FALLBACK_MODELS=gemma4-e2b,gemma4-31b
DOCTOR_OPENWEIGHT_MODEL=gpt-oss-20b
DOCTOR_OPENWEIGHT_API_KEY=
DOCTOR_REVIEWER_HEALTH_URL=http://<cerberus-host>:8080/health
